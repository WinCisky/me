---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';

Astro.response.status = 404;
---

<Layout title="Page not found — Simone Simonella" noindex>
	<Window title="404">
		<div class="flex h-full flex-col items-center justify-center gap-3 px-6 py-16 text-center">
			<p class="text-5xl font-bold text-ink">404</p>
			<p class="text-sm text-ink-muted">This page doesn't exist.</p>
			<div class="mt-4 flex flex-wrap justify-center gap-2">
				<a
					href="/"
					class="rounded-full bg-accent px-3.5 py-1 text-[12px] font-medium text-white no-underline hover:opacity-80"
				>
					Recent
				</a>
				<a
					href="/projects"
					class="rounded-full bg-button px-3.5 py-1 text-[12px] font-medium text-ink no-underline hover:opacity-80"
				>
					Projects
				</a>
				<a
					href="/about"
					class="rounded-full bg-button px-3.5 py-1 text-[12px] font-medium text-ink no-underline hover:opacity-80"
				>
					About
				</a>
			</div>
		</div>
	</Window>
</Layout>
