---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import FileIcon from '../../components/FileIcon.astro';
import Window from '../../components/Window.astro';
import Layout from '../../layouts/Layout.astro';
import { GITHUB_USER } from '../../lib/github';

const { slug } = Astro.params;
const entry = slug ? await getEntry('projects', slug) : undefined;

if (!entry) {
	return new Response('Not found', { status: 404 });
}

const { Content } = await render(entry);
const { title, repo, summary, icon, preview } = entry.data;

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');
---

<Layout title={`${title ?? repo} — Simone Simonella`} description={summary}>
	<Window
		active="projects"
		title={`${repo}.md`}
		backHref="/"
		path={['Users', 'ssimonella', 'Projects', `${repo}.md`]}
	>
		<a
			slot="toolbar-end"
			href={`https://github.com/${GITHUB_USER}/${repo}`}
			target="_blank"
			rel="noopener noreferrer"
			class="rounded-full bg-button px-3.5 py-1 text-[13px] font-medium whitespace-nowrap text-ink no-underline hover:opacity-80"
		>
			Open in GitHub
		</a>

		<article class="prose flex flex-col gap-3 px-4 py-3 text-ink">
			<header class="flex items-center gap-3">
				<FileIcon icon={icon} class="w-10 h-10" />
				<div class="flex flex-col">
					<h1 class="text-lg font-bold text-ink">{title ?? repo}</h1>
					{summary && <p class="text-sm text-ink-muted">{summary}</p>}
				</div>
			</header>

			{preview && (
				<Image
					src={preview}
					alt={`${title ?? repo} preview`}
					class="w-full rounded-md border border-hairline"
					loading="eager"
				/>
			)}

			<div class="text-sm leading-relaxed">
				<Content />
			</div>
		</article>
	</Window>
</Layout>

<style>
	.prose :global(h2) {
		margin: 0.75rem 0 0.25rem;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--s-ink);
	}

	.prose :global(p) {
		margin: 0 0 0.5rem;
	}

	.prose :global(ul) {
		margin: 0 0 0.5rem;
		padding-left: 1.1rem;
		list-style: disc;
	}

	.prose :global(a) {
		color: var(--s-accent);
		text-decoration: underline;
	}

	.prose :global(code) {
		background: var(--s-code);
		border-radius: 4px;
		padding: 0.05rem 0.25rem;
		font-size: 0.85em;
	}
</style>
