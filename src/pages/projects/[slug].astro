---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import FileIcon from '../../components/FileIcon.astro';
import Window from '../../components/Window.astro';
import Layout from '../../layouts/Layout.astro';
import { GITHUB_USER } from '../../lib/github';

const { slug } = Astro.params;
const entry = slug ? await getEntry('projects', slug) : undefined;

if (!entry) {
	return new Response('Not found', { status: 404 });
}

const { Content } = await render(entry);
const { title, repo, summary, icon, preview } = entry.data;

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');
---

<Layout>
	<Window active="projects">
		<article class="prose flex flex-col gap-3 px-3 py-2 text-gray-700">
			<header class="flex items-center gap-3">
				<FileIcon icon={icon} class="w-10 h-10" />
				<div class="flex flex-col">
					<h1 class="text-lg font-bold text-gray-800">{title ?? repo}</h1>
					{summary && <p class="text-sm text-gray-500">{summary}</p>}
				</div>
			</header>

			{preview && (
				<Image
					src={preview}
					alt={`${title ?? repo} preview`}
					class="w-full rounded-md border border-gray-300"
					loading="eager"
				/>
			)}

			<div class="text-sm leading-relaxed">
				<Content />
			</div>

			<footer class="flex gap-4 border-t border-gray-300 pt-2 text-sm">
				<a class="text-blue-600 hover:underline" href="/">&larr; Back</a>
				<a
					class="text-blue-600 hover:underline"
					href={`https://github.com/${GITHUB_USER}/${repo}`}
					target="_blank"
					rel="noopener noreferrer"
				>
					View on GitHub
				</a>
			</footer>
		</article>
	</Window>
</Layout>

<style>
	.prose :global(h2) {
		margin: 0.75rem 0 0.25rem;
		font-size: 0.95rem;
		font-weight: 700;
		color: #1f2937;
	}

	.prose :global(p) {
		margin: 0 0 0.5rem;
	}

	.prose :global(ul) {
		margin: 0 0 0.5rem;
		padding-left: 1.1rem;
		list-style: disc;
	}

	.prose :global(a) {
		color: #2563eb;
		text-decoration: underline;
	}

	.prose :global(code) {
		background: #f3f4f6;
		border-radius: 4px;
		padding: 0.05rem 0.25rem;
		font-size: 0.85em;
	}
</style>
