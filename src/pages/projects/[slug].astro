---
import { getEntry, render } from 'astro:content';
import FileIcon from '../../components/FileIcon.astro';
import Preview from '../../components/Preview.astro';
import Window from '../../components/Window.astro';
import Layout from '../../layouts/Layout.astro';
import { fetchPublicRepos, GITHUB_USER } from '../../lib/github';
import { SITE_NAME, SITE_URL } from '../../lib/site';

// Old mixed-case slugs, kept working via a permanent redirect to their lowercase-kebab replacement.
const SLUG_ALIASES: Record<string, string> = {
	OpentrustShopifyApp: 'opentrust-shopify',
};

const { slug } = Astro.params;

if (slug && slug in SLUG_ALIASES) {
	return Astro.redirect(`/projects/${SLUG_ALIASES[slug]}`, 301);
}

const entry = slug ? await getEntry('projects', slug) : undefined;

if (!entry) {
	return Astro.rewrite('/404');
}

const { Content } = await render(entry);
const { title, repo, summary, description, tags, homepage, icon, preview } = entry.data;
const displayTitle = title ?? repo;
const metaDescription = description ?? summary;

let dateCreated: string | undefined;
let dateModified: string | undefined;
try {
	const matchedRepo = (await fetchPublicRepos(GITHUB_USER)).find(
		(r) => r.name.toLowerCase() === repo.toLowerCase(),
	);
	dateCreated = matchedRepo?.created_at;
	dateModified = matchedRepo?.pushed_at;
} catch {
	// GitHub API unavailable — structured data simply omits the dates.
}

const canonicalUrl = `${SITE_URL}/projects/${entry.id}`;
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareSourceCode',
		name: displayTitle,
		description: metaDescription,
		url: homepage ?? canonicalUrl,
		codeRepository: `https://github.com/${GITHUB_USER}/${repo}`,
		author: { '@type': 'Person', name: SITE_NAME, url: SITE_URL },
		...(dateCreated && { dateCreated }),
		...(dateModified && { dateModified }),
		...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Projects', item: `${SITE_URL}/projects` },
			{ '@type': 'ListItem', position: 2, name: displayTitle, item: canonicalUrl },
		],
	},
];

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');
---

<Layout
	title={`${displayTitle} — ${SITE_NAME}`}
	description={metaDescription}
	ogType="article"
	jsonLd={jsonLd}
>
	<Window
		active="projects"
		title={`${repo}.md`}
		backHref="/projects"
		path={['Users', 'ssimonella', 'Projects', `${repo}.md`]}
	>
		<a
			slot="toolbar-end"
			href={`https://github.com/${GITHUB_USER}/${repo}`}
			target="_blank"
			rel="noopener noreferrer"
			class="rounded-full bg-button px-3.5 py-1 text-[13px] font-medium whitespace-nowrap text-ink no-underline hover:opacity-80"
		>
			Open in GitHub
		</a>

		<article class="prose flex flex-col gap-3 px-4 py-3 text-ink">
			<header class="flex items-center gap-3">
				<FileIcon icon={icon} class="w-10 h-10" />
				<div class="flex flex-col">
					<h1 class="text-lg font-bold text-ink">{title ?? repo}</h1>
					{summary && <p class="text-sm text-ink-muted">{summary}</p>}
				</div>
			</header>

			{preview && (
				<Preview
					src={preview}
					slug={entry.id}
					alt={`${title ?? repo} preview`}
					class="w-full overflow-hidden rounded-md border border-hairline"
					imgClass="block w-full"
					sizes="(min-width: 768px) 700px, 92vw"
					eager
				/>
			)}

			<div class="text-sm leading-relaxed">
				<Content />
			</div>
		</article>
	</Window>
</Layout>

<style>
	.prose :global(h2) {
		margin: 0.75rem 0 0.25rem;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--s-ink);
	}

	.prose :global(p) {
		margin: 0 0 0.5rem;
	}

	.prose :global(ul) {
		margin: 0 0 0.5rem;
		padding-left: 1.1rem;
		list-style: disc;
	}

	.prose :global(a) {
		color: var(--s-accent);
		text-decoration: underline;
	}

	.prose :global(code) {
		background: var(--s-code);
		border-radius: 4px;
		padding: 0.05rem 0.25rem;
		font-size: 0.85em;
	}
</style>
