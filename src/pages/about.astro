---
import avatar from "../assets/me-480.webp";
import TabBar from "../components/TabBar.astro";
import Layout from "../layouts/Layout.astro";
import {
    BIRTH_DATE,
    CAREER_START,
    CONTACT_EMAIL,
    DESCRIPTION,
    GITHUB_URL,
    LINKEDIN_URL,
    LOCATION,
    ROLE,
    SITE_NAME,
    SITE_URL,
    SOCIALS,
} from "../lib/site";

const today = new Date();

function yearsSince(isoDate: string): number {
    const from = new Date(isoDate);
    let years = today.getUTCFullYear() - from.getUTCFullYear();
    const beforeAnniversary =
        today.getUTCMonth() < from.getUTCMonth() ||
        (today.getUTCMonth() === from.getUTCMonth() &&
            today.getUTCDate() < from.getUTCDate());
    if (beforeAnniversary) years -= 1;
    return years;
}

const plural = (years: number) => `${years} ${years === 1 ? "year" : "years"}`;

const rows = [
    { label: "Age", value: plural(yearsSince(BIRTH_DATE)) },
    { label: "Working for", value: plural(yearsSince(CAREER_START)) },
    { label: "Based in", value: LOCATION },
];

const title = `About ${SITE_NAME} — ${ROLE} in ${LOCATION}`;
const description = DESCRIPTION;

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        name: title,
        url: `${SITE_URL}/about`,
        mainEntity: {
            '@type': 'Person',
            name: SITE_NAME,
            jobTitle: ROLE,
            url: SITE_URL,
            email: `mailto:${CONTACT_EMAIL}`,
            address: { '@type': 'PostalAddress', addressCountry: LOCATION },
            sameAs: SOCIALS,
        },
    },
];

// The table only changes at midnight, so cache the page until then.
const nextMidnight = Date.UTC(
    today.getUTCFullYear(),
    today.getUTCMonth(),
    today.getUTCDate() + 1,
);
const secondsUntilMidnight = Math.max(
    60,
    Math.floor((nextMidnight - today.getTime()) / 1000),
);
Astro.response.headers.set(
    "Cache-Control",
    `public, max-age=0, s-maxage=${secondsUntilMidnight}`,
);
---

<Layout title={title} description={description} ogType="profile" jsonLd={jsonLd}>
    <div class="flex w-[340px] flex-col overflow-hidden rounded-xl border border-hairline bg-window shadow-2xl max-md:min-h-dvh max-md:w-full max-md:rounded-none max-md:border-0 max-md:shadow-none">
        <header class="hidden h-11 shrink-0 items-center gap-2 px-4 md:flex">
            <a
                href="/"
                aria-label="Close"
                class="h-3 w-3 rounded-full bg-red-500"
            ></a>
            <span
                class="h-3 w-3 rounded-full bg-hairline"
                aria-hidden="true"
            ></span>
            <span
                class="h-3 w-3 rounded-full bg-hairline"
                aria-hidden="true"
            ></span>
        </header>

        <div class="flex flex-col items-center px-8 pt-6 pb-8 max-md:my-auto max-md:pb-24">
            <img
                src={avatar.src}
                width={avatar.width}
                height={avatar.height}
                alt={SITE_NAME}
                class="h-40 w-auto rounded-md object-cover"
            />

            <h1 class="mt-8 text-center text-[22px] font-bold text-ink">
                {SITE_NAME}
            </h1>
            <p class="mt-0.5 text-center text-xs text-ink-muted">{ROLE}</p>

            <table class="mt-7 border-collapse text-[13px]">
                <tbody>
                    {rows.map((row) => (
                        <tr>
                            <th class="py-0.5 pr-2 text-right font-semibold whitespace-nowrap text-ink">
                                {row.label}
                            </th>
                            <td class="py-0.5 pl-2 text-left whitespace-nowrap text-ink/80">
                                {row.value}
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
                <a
                    href={GITHUB_URL}
                    target="_blank"
                    rel="noopener noreferrer me"
                    class="rounded-full bg-button px-4 py-1 text-[13px] font-medium text-ink no-underline hover:opacity-80"
                >
                    GitHub
                </a>
                <a
                    href={LINKEDIN_URL}
                    target="_blank"
                    rel="noopener noreferrer me"
                    class="rounded-full bg-button px-4 py-1 text-[13px] font-medium text-ink no-underline hover:opacity-80"
                >
                    LinkedIn
                </a>
                <a
                    href={`mailto:${CONTACT_EMAIL}`}
                    rel="me"
                    class="rounded-full bg-button px-4 py-1 text-[13px] font-medium text-ink no-underline hover:opacity-80"
                >
                    Email
                </a>
            </div>

            <p class="mt-6 text-center text-[11px] leading-relaxed text-ink-muted">
                {DESCRIPTION}
            </p>
        </div>
    </div>
    <TabBar active="about" />
</Layout>
