---
import '../styles/global.css';
import Seo from '../components/Seo.astro';

interface Props {
	title?: string;
	description?: string;
	ogType?: 'website' | 'profile' | 'article';
	ogImage?: string;
	noindex?: boolean;
	jsonLd?: object[];
}

const {
	title = 'Simone Simonella',
	description,
	ogType,
	ogImage,
	noindex,
	jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#e9e9ed" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="alternate" type="application/rss+xml" title={`${title} — RSS`} href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<Seo title={title} description={description} ogType={ogType} ogImage={ogImage} noindex={noindex} jsonLd={jsonLd} />
	</head>
	<body class="min-h-dvh flex items-center justify-center bg-desktop">
		<svg
			class="fixed inset-0 -z-10 h-full w-full text-ink"
			viewBox="0 0 1440 900"
			preserveAspectRatio="xMidYMax slice"
			aria-hidden="true"
		>
			<polygon
				opacity="0.05"
				fill="currentColor"
				points="0,560 140,360 260,470 420,300 560,460 700,340 880,480 1040,330 1200,470 1330,380 1440,460 1440,900 0,900"
			/>
			<polygon
				opacity="0.08"
				fill="currentColor"
				points="0,640 180,480 360,620 540,450 720,610 900,470 1100,640 1260,520 1440,620 1440,900 0,900"
			/>
			<polygon
				opacity="0.12"
				fill="currentColor"
				points="0,760 240,600 480,740 760,580 1000,730 1240,620 1440,720 1440,900 0,900"
			/>
		</svg>
		<slot />
	</body>
</html>
