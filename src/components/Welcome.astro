---
import { getCollection } from 'astro:content';
import { fetchPublicRepos, GITHUB_USER, type Repo } from '../lib/github';
import FileIcon from './FileIcon.astro';
import Window from './Window.astro';

let repos: Repo[] = [];
let error: string | null = null;

try {
	repos = await fetchPublicRepos(GITHUB_USER);
} catch {
	error = 'Could not load projects.';
}

const highlights = new Map(
	(await getCollection('projects')).map((entry) => [entry.data.repo.toLowerCase(), entry]),
);

const byYear = new Map<number, Repo[]>();
for (const repo of repos) {
	const year = new Date(repo.pushed_at).getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(repo);
}

const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<Window active="projects" title="Projects">
	<h1 class="sr-only">Projects by Simone Simonella</h1>
	{years.map(([year, yearRepos]) => (
		<>
			<h2 class="px-4 py-2 text-[13px] font-semibold text-ink-muted not-first:border-t border-hairline">
				{year}
			</h2>
			<div class="grid grid-cols-4 items-start gap-x-2 gap-y-4 px-4 pt-1 pb-5 md:flex md:flex-wrap md:gap-x-3 md:gap-y-5">
				{yearRepos.map((repo) => {
					const highlight = highlights.get(repo.name.toLowerCase());
					const external = !highlight;

					return (
						<a
							class:list={[
								'group flex w-22 flex-col items-center gap-1 no-underline transition-opacity hover:opacity-100',
								!highlight && 'opacity-60',
							]}
							href={highlight ? `/projects/${highlight.id}` : repo.html_url}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener noreferrer' : undefined}
							title={highlight?.data.summary ?? repo.description ?? undefined}
						>
							<FileIcon icon={highlight?.data.icon} class="w-14 h-14" />
							<span class="text-center text-xs text-ink wrap-anywhere hyphens-auto group-hover:text-accent group-hover:underline">
								{highlight?.data.title ?? repo.name}
							</span>
						</a>
					);
				})}
			</div>
		</>
	))}
	{years.length === 0 && (
		<div class="px-4 py-2 text-sm text-ink-muted">
			{error ?? 'No public projects found.'}
		</div>
	)}
</Window>
