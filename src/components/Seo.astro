---
import { DEFAULT_OG_IMAGE, SITE_NAME } from '../lib/site';

interface Props {
	title: string;
	description?: string;
	ogType?: 'website' | 'profile' | 'article';
	ogImage?: string;
	noindex?: boolean;
	jsonLd?: object[];
}

const { title, description, ogType = 'website', ogImage = DEFAULT_OG_IMAGE, noindex = false, jsonLd = [] } = Astro.props;

// Strip query/hash and any trailing slash so the canonical is always the same
// URL regardless of how the page was requested.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = new URL(canonicalPath, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalURL} />
<meta name="author" content={SITE_NAME} />
<meta
	name="robots"
	content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
/>

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={absoluteOgImage} />

{jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
