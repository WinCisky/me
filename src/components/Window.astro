---
import chevronLeftIcon from '../assets/chevron-left.svg';
import chevronRightIcon from '../assets/chevron-right.svg';
import clockIcon from '../assets/clock.svg';
import folderGitIcon from '../assets/folder-git.svg';
import squareUserIcon from '../assets/square-user.svg';
import TabBar from './TabBar.astro';

interface Props {
	active?: 'recent' | 'projects' | 'about';
	title?: string;
	sidebar?: boolean;
	backHref?: string;
	path?: string[];
}

const { active = 'recent', title, sidebar = true, backHref, path } = Astro.props;

const crumbs = path ?? ['Users', 'ssimonella', title ?? ''];

const links = [
	{ label: 'Recent', href: '/', key: 'recent', icon: clockIcon },
	{ label: 'Projects', href: '/projects', key: 'projects', icon: folderGitIcon },
	{ label: 'About', href: '/about', key: 'about', icon: squareUserIcon },
] as const;

const ChevronLeft = chevronLeftIcon;
const ChevronRight = chevronRightIcon;
---

<div
	class:list={[
		'flex w-[min(1000px,92vw)] h-[min(700px,88dvh)] overflow-hidden rounded-xl border border-hairline bg-window shadow-2xl max-md:h-dvh max-md:w-full max-md:rounded-none max-md:border-0 max-md:shadow-none',
		sidebar && 'gap-2 p-2 max-md:p-0',
	]}
>
	{sidebar && (
		<aside class="hidden w-52 shrink-0 flex-col overflow-hidden rounded-lg border-2 border-panel bg-sidebar shadow-sm md:flex">
			<div class="flex h-12 shrink-0 items-center gap-2 px-4">
				<span class="h-3 w-3 rounded-full bg-red-500" aria-hidden="true"></span>
				<span class="h-3 w-3 rounded-full bg-yellow-500" aria-hidden="true"></span>
				<span class="h-3 w-3 rounded-full bg-green-500" aria-hidden="true"></span>
			</div>
			<nav aria-label="Sections" class="flex-1 overflow-y-auto px-2.5 pb-3 pt-2">
				<p class="mb-1 px-2.5 text-[11px] font-semibold text-ink-muted">Favorites</p>
				<ul class="flex flex-col gap-0.5">
					{links.map((link) => {
						const Icon = link.icon;
						return (
							<li>
								<a
									href={link.href}
									aria-current={active === link.key ? 'page' : undefined}
									class:list={[
										'flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-[13px] text-ink no-underline hover:bg-selected',
										active === link.key && 'bg-selected',
									]}
								>
									<Icon class="h-4 w-4 shrink-0 text-ink-muted" aria-hidden="true" />
									{link.label}
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
		</aside>
	)}
	<div
		class:list={[
			'flex min-w-0 flex-1 flex-col bg-content',
			sidebar && 'overflow-hidden rounded-lg max-md:rounded-none',
		]}
	>
		<header
			class:list={[
				'flex h-13 shrink-0 items-center gap-3 border-b border-hairline px-4',
				sidebar ? 'bg-content' : 'bg-titlebar',
				sidebar && !backHref && 'max-md:hidden',
			]}
		>
			{sidebar ? (
				<div class="flex items-center rounded-lg border-2 border-panel bg-sidebar text-ink-muted shadow-sm max-md:border-0 max-md:bg-transparent max-md:shadow-none">
					{backHref && (
						<a
							href={backHref}
							aria-label="Back to Projects"
							class="flex items-center rounded-l-md px-1.5 py-1 no-underline hover:bg-selected max-md:text-accent md:hidden"
						>
							<ChevronLeft class="h-5 w-5" aria-hidden="true" />
							<span class="text-sm font-medium">Projects</span>
						</a>
					)}
					<button
						type="button"
						data-history="back"
						aria-label="Back"
						disabled
						class="hidden items-center rounded-l-md px-1.5 py-1 enabled:hover:bg-selected disabled:opacity-40 md:flex"
					>
						<ChevronLeft class="h-4 w-4" aria-hidden="true" />
					</button>
					<button
						type="button"
						data-history="forward"
						aria-label="Forward"
						disabled
						class="hidden items-center rounded-r-md px-1.5 py-1 enabled:hover:bg-selected disabled:opacity-40 md:flex"
					>
						<ChevronRight class="h-4 w-4" aria-hidden="true" />
					</button>
				</div>
			) : (
				<slot name="toolbar-start" />
			)}
			<div class="min-w-0 flex-1 truncate text-[15px] font-bold text-ink">{title}</div>
			<slot name="toolbar-end" />
		</header>
		{sidebar && !backHref && (
			<div class="shrink-0 border-b border-hairline px-4 pt-3 pb-2 text-3xl font-bold text-ink md:hidden">
				{title}
			</div>
		)}
		<main class:list={['flex-1 overflow-y-auto', sidebar && 'max-md:pb-24']}>
			<slot />
		</main>
		{sidebar && (
			<footer class="hidden h-7 shrink-0 items-center justify-center gap-1.5 border-t border-hairline px-3 text-[11px] text-ink-muted md:flex">
				{crumbs.map((crumb, i) => (
					<>
						{i > 0 && <ChevronRight class="h-2.5 w-2.5 opacity-60" aria-hidden="true" />}
						<span>{crumb}</span>
					</>
				))}
			</footer>
		)}
	</div>
</div>
{sidebar && <TabBar active={active} />}

<script>
	const STORAGE_KEY = 'finder-history';

	const backBtn = document.querySelector<HTMLButtonElement>('[data-history="back"]');
	const forwardBtn = document.querySelector<HTMLButtonElement>('[data-history="forward"]');

	function readState(): { idx: number; max: number } | null {
		try {
			const raw = sessionStorage.getItem(STORAGE_KEY);
			return raw ? JSON.parse(raw) : null;
		} catch {
			return null;
		}
	}

	function writeState(state: { idx: number; max: number }) {
		try {
			sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state));
		} catch {
			// sessionStorage unavailable (private mode, etc.)
		}
	}

	function sync() {
		if (!backBtn && !forwardBtn) return;

		const stored = readState();
		const historyIdx = (history.state as { finderIdx?: number } | null)?.finderIdx;

		let idx: number;
		let max: number;

		if (typeof historyIdx === 'number') {
			// Landed here via back/forward: reuse the position this entry was given when first visited.
			idx = historyIdx;
			max = Math.max(stored?.max ?? idx, idx);
		} else {
			// A fresh navigation: advance past the last known position and drop any forward entries.
			idx = (stored?.idx ?? -1) + 1;
			max = idx;
			history.replaceState({ ...history.state, finderIdx: idx }, '');
		}

		writeState({ idx, max });

		if (backBtn) backBtn.disabled = idx <= 0;
		if (forwardBtn) forwardBtn.disabled = idx >= max;
	}

	sync();

	// bfcache restores don't re-run module scripts, so re-sync explicitly.
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) sync();
	});

	backBtn?.addEventListener('click', () => history.back());
	forwardBtn?.addEventListener('click', () => history.forward());
</script>
