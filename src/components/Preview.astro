---
import type { ImageMetadata } from 'astro';
import { PREVIEW_VARIANTS } from '../lib/preview-variants';

interface Props {
	src: ImageMetadata;
	slug: string;
	alt?: string;
	class?: string;
	imgClass?: string;
	sizes: string;
	eager?: boolean;
}

const { src, slug, alt = '', class: className, imgClass, sizes, eager = false } = Astro.props;

// Pre-shrunk at build time by scripts/generate-assets.mjs — Deno Deploy has
// no Sharp at runtime, so this can't go through astro:assets' <Image>.
const variants = PREVIEW_VARIANTS[slug] ?? [src];
const srcset = variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
---

<div class:list={['group relative', className]} data-preview>
	<div class="skeleton absolute inset-0 group-data-[loaded]:hidden" aria-hidden="true"></div>
	<img
		src={src.src}
		srcset={srcset}
		sizes={sizes}
		width={src.width}
		height={src.height}
		alt={alt}
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : 'auto'}
		decoding="async"
		class:list={[
			'opacity-0 transition-opacity duration-200 group-data-[loaded]:opacity-100',
			imgClass,
		]}
	/>
</div>

<script>
	for (const frame of document.querySelectorAll<HTMLElement>('[data-preview]')) {
		const img = frame.querySelector('img');
		if (!img) continue;

		const done = () => {
			frame.dataset.loaded = '';
		};

		// A cached image can already be done before this module runs.
		if (img.complete && img.naturalWidth > 0) done();
		else {
			img.addEventListener('load', done, { once: true });
			img.addEventListener('error', done, { once: true });
		}
	}
</script>
